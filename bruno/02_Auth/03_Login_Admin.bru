meta {
  name: Login administrador
  type: http
  seq: 3
}

post {
  url: {{apiUrl}}/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "correo": "admin@tianguisdigital.mx",
    "contrasena": "12345"
  }
}

script:post-response {
  if (res.status === 200) {
    bru.setEnvVar("token", res.getBody().token, { persist: true });
  }
}
